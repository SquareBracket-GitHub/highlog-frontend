import { router } from 'expo-router';
import { useState } from 'react';
import { ScrollView, Text, TextInput, TouchableOpacity, View, Alert } from 'react-native';

import { CommonStyles } from './styles';
import { apiFetch } from '../utils/api';

export default function RegisterScreen() {
  const [name, setName] = useState('');
  const [username, setUsername] = useState('');
  const [loginId, setLoginId] = useState('');
  const [password, setPassword] = useState('');
  const [grade, setGrade] = useState('');
  const [classNo, setClassNo] = useState('');
  const [schoolNumber, setSchoolNumber] = useState('');

  const handleRegister = async () => {
    try {
      const body = {
        username: name || username,
        login_id: loginId || username,
        password,
        grade: Number(grade),
        class_no: Number(classNo),
        school_number: Number(schoolNumber)
      };

      await apiFetch('/students', {
        method: 'POST',
        body: JSON.stringify(body)
      });

      Alert.alert('가입 성공', '계정이 생성되었습니다. 로그인 페이지로 이동합니다.');
      router.push('/login');
    } catch (err: any) {
      const message = err?.data?.message || JSON.stringify(err?.data) || '서버 요청에 실패했습니다.';
      Alert.alert('가입 실패', message);
    }
  };

  return (
    <ScrollView
      style={CommonStyles.scrollContainer}
      contentContainerStyle={{
        paddingHorizontal: 24,
        paddingVertical: 60,
      }}
    >
      {/* 제목 */}
      <View style={CommonStyles.registerTitleContainer}>
        <Text style={CommonStyles.registerTitle}>회원가입</Text>
      </View>

      {/* 이름 (표시명) */}
      <InputLabel label="이름(표시명)" />
      <TextInput
        value={name}
        onChangeText={setName}
        placeholder="이름을 입력하세요"
        placeholderTextColor="#AAA"
        style={CommonStyles.inputWithMargin}
      />

      {/* 사용자명 (선택) */}
      <InputLabel label="사용자명 (선택)" />
      <TextInput
        value={username}
        onChangeText={setUsername}
        placeholder="사용자명을 입력하세요 (표시용)"
        placeholderTextColor="#AAA"
        style={CommonStyles.inputWithMargin}
      />

      {/* 로그인 아이디 */}
      <InputLabel label="로그인 아이디" />
      <TextInput
        value={loginId}
        onChangeText={setLoginId}
        placeholder="로그인에 사용할 아이디를 입력하세요"
        placeholderTextColor="#AAA"
        style={CommonStyles.inputWithMargin}
      />

      {/* 비밀번호 */}
      <InputLabel label="비밀번호" />
      <TextInput
        value={password}
        onChangeText={setPassword}
        secureTextEntry
        placeholder="비밀번호를 입력하세요"
        placeholderTextColor="#AAA"
        style={CommonStyles.inputWithMargin}
      />

      {/* 학년 */}
      <InputLabel label="학년" />
      <TextInput
        value={grade}
        onChangeText={setGrade}
        placeholder="예: 1"
        placeholderTextColor="#AAA"
        keyboardType="numeric"
        style={CommonStyles.inputWithMargin}
      />

      {/* 반 */}
      <InputLabel label="반" />
      <TextInput
        value={classNo}
        onChangeText={setClassNo}
        placeholder="예: 3"
        placeholderTextColor="#AAA"
        keyboardType="numeric"
        style={CommonStyles.inputWithMargin}
      />

      {/* 학번 */}
      <InputLabel label="학번" />
      <TextInput
        value={schoolNumber}
        onChangeText={setSchoolNumber}
        placeholder="학번을 입력하세요"
        placeholderTextColor="#AAA"
        keyboardType="numeric"
        style={CommonStyles.inputWithMargin}
      />

      {/* 가입 버튼 */}
      <TouchableOpacity
        onPress={handleRegister}
        style={[CommonStyles.primaryButton, { marginTop: 20, marginBottom: 20 }]}
      >
        <Text style={CommonStyles.primaryButtonText}>가입하기</Text>
      </TouchableOpacity>

      {/* 로그인 이동 */}
      <TouchableOpacity onPress={() => router.push('/login')}>
        <Text style={CommonStyles.secondaryText}>이미 계정이 있으신가요?</Text>
      </TouchableOpacity>
    </ScrollView>
  );
}

/* 헬퍼 컴포넌트 */
function InputLabel({ label }: { label: string }) {
  return (
    <Text
      style={{
        marginBottom: 8,
        marginLeft: 4,
        fontSize: 13,
        color: '#444',
      }}
    >
      {label}
    </Text>
  );
}
